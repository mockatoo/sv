{
	"name": "@mockatoo/sv",
	"version": "0.1.0",
	"description": "Svelte CLI add-on: GitHub sign-in with Better Auth that works in development without a GitHub OAuth app, using the free Mockatoo mock.",
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit",
		"better-auth",
		"oauth",
		"github",
		"mock",
		"e2e",
		"playwright",
		"mockatoo"
	],
	"homepage": "https://github.com/mockatoo/sv#readme",
	"bugs": {
		"url": "https://github.com/mockatoo/sv/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mockatoo/sv.git"
	},
	"license": "MIT",
	"author": "GlobalUnderdog",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"demo-create": "sv create demo --types ts --template minimal --no-add-ons --no-install",
		"demo-add": "pnpm build && sv add file:../ --cwd demo --no-git-check --no-install",
		"build": "tsdown",
		"prepublishOnly": "npm run build",
		"test": "vitest run",
		"typecheck": "tsc -p jsconfig.json --noEmit",
		"cli:check": "bash scripts/cli-check.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/sv-utils": "^1.1.3",
		"@types/node": "^26.6.6",
		"sv": "^1.7.0",
		"tsdown": "^0.23.7",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"sv": "^1.7.0"
	}
}
